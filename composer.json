{
    "name": "benammi/php-arrays-all-in-one",
    "description": "A safe, typed, fully documented PHP toolkit for everyday array operations.",
    "keywords": [
        "php",
        "array",
        "arrays",
        "helpers",
        "utilities",
        "php-arrays-all-in-one",
        "benammi"
    ],
    "homepage": "https://github.com/benammi/php-arrays-all-in-one",
    "license": "MIT",
    "authors": [
        {
            "name": "Hamza Benammi",
            "email": "benammihamza@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^2.0|^3.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Benammi\\ArrayAIO\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Benammi\\ArrayAIO\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
